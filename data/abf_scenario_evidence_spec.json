    "UPSIDE": {
      "desired_target_direction": "POSITIVE",
      "leading_sources": [
        {
          "source_id": "tpca_public_industry",
          "metric_id": "pcb_revenue_yoy",
          "source_name": "TPCA PCB Revenue YoY",
          "lag_months": 1,
          "trigger": "POSITIVE_FEATURE",
          "role": "Leading demand/throughput evidence"
        }
      ],
      "confirmatory_sources": [
        {
          "source_id": "mops_abf_monthly_revenue",
          "metric_id": "abf_company_revenue_yoy::*",
          "source_name": "MOPS-derived ABF company monthly revenue",
          "role": "Coincident company confirmation"
        }
      ]
    },
    "DOWNSIDE": {
      "desired_target_direction": "NEGATIVE",
      "leading_sources": [
        {
          "source_id": "tpca_public_industry",
          "metric_id": "pcb_revenue_yoy",
          "source_name": "TPCA PCB Revenue YoY",
          "lag_months": 1,
          "trigger": "NEGATIVE_FEATURE",
          "role": "Leading deterioration evidence; independently validated from upside"
        }
      ],
      "confirmatory_sources": [
        {
          "source_id": "mops_abf_monthly_revenue",
          "metric_id": "abf_company_revenue_yoy::*",
          "source_name": "MOPS-derived ABF company monthly revenue",
          "role": "Coincident deterioration confirmation"
        }
      ]
    }
  }
}
