   </dc:title>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Protect the world and preserve nature and sustainable environment, glass globe and trees growing on green grass and natural light.</rdf:li>
    </rdf:Alt>
   </dc:description>
